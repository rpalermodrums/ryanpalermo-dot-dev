{
  "name": "ryanpalermo-dot-dev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter web build:with-blog",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/react-router": "1.120.3",
      "@tanstack/router-generator": "1.120.3",
      "@tanstack/router-plugin": "1.120.3",
      "@tanstack/start-config": "1.120.3",
      "@tanstack/start-client": "1.120.3",
      "@tanstack/start-server": "1.120.3",
      "@tanstack/start-server-functions-fetcher": "1.120.3",
      "@tanstack/start-server-functions-handler": "1.120.3",
      "@tanstack/start-server-functions-ssr": "1.120.3",
      "@tanstack/start-router-manifest": "1.120.3",
      "@tanstack/start-api-routes": "1.120.3",
      "@tanstack/react-start": "1.120.3",
      "@tanstack/react-start-client": "1.120.3",
      "@tanstack/react-start-server": "1.120.3"
    }
  }
}
