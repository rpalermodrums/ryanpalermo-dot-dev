---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{post.data.title} — Ryan Palermo</title>
  <meta name="description" content={post.data.excerpt}>
  <meta property="og:title" content={post.data.title}>
  <meta property="og:description" content={post.data.excerpt}>
  <meta property="og:type" content="article">
  <link rel="alternate" type="application/rss+xml" title="Ryan Palermo's Blog" href="/rss.xml">
  <style>
    :root {
      --bg: #0c0c0c;
      --fg: #f2f2f2;
      --fg-muted: #a3a3a3;
      --fg-dim: #808080;
      --border: #333333;
      --surface: #111;
      --surface-hover: #1f1f1f;
      --accent: #22d3ee;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "SF Mono", Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 14px;
      line-height: 1.6;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--accent);
      color: var(--bg);
    }

    .container {
      max-width: 700px;
      margin: 0 auto;
      padding: 32px 48px 64px;
    }

    @media (max-width: 640px) {
      .container { padding: 24px 24px 48px; }
    }

    a {
      color: var(--accent);
      text-decoration: none;
      transition: opacity 0.15s;
    }

    a:hover { opacity: 0.8; }

    .back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--fg-dim);
      margin-bottom: 32px;
    }

    .back:hover { color: var(--fg-muted); opacity: 1; }

    /* Article Window */
    .article-window {
      background: var(--surface);
      border: 1px solid var(--border);
    }

    .window-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      background: linear-gradient(180deg, #181818 0%, #131313 100%);
      border-bottom: 1px solid var(--border);
    }

    .window-buttons {
      display: flex;
      gap: 6px;
    }

    .window-button {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #444;
      transition: background 0.2s;
    }

    .article-window:hover .window-button.close { background: #ff5f57; }
    .article-window:hover .window-button.minimize { background: #febc2e; }
    .article-window:hover .window-button.maximize { background: #28c840; }

    .window-title {
      flex: 1;
      text-align: center;
      font-size: 11px;
      color: var(--fg-dim);
      margin-right: 30px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .window-content {
      padding: 32px;
    }

    @media (max-width: 640px) {
      .window-content { padding: 24px; }
    }

    /* Header */
    header {
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    h1 {
      font-size: 24px;
      font-weight: 400;
      letter-spacing: -0.5px;
      line-height: 1.3;
      margin-bottom: 8px;
    }

    .subtitle {
      color: var(--fg-muted);
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .date {
      font-size: 11px;
      color: var(--fg-dim);
    }

    /* Content */
    .content {
      color: var(--fg-muted);
      line-height: 1.7;
    }

    .content h2 {
      color: var(--fg);
      font-size: 16px;
      font-weight: 400;
      margin: 32px 0 16px;
    }

    .content h3 {
      color: var(--fg);
      font-size: 14px;
      font-weight: 400;
      margin: 24px 0 12px;
    }

    .content p {
      margin-bottom: 16px;
    }

    .content ul, .content ol {
      margin-bottom: 16px;
      padding-left: 24px;
    }

    .content li {
      margin-bottom: 8px;
    }

    .content li::marker {
      color: var(--fg-dim);
    }

    .content blockquote {
      border-left: 2px solid var(--accent);
      padding-left: 16px;
      margin: 24px 0;
      color: var(--fg-muted);
    }

    .content code {
      background: var(--bg);
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 13px;
    }

    .content pre {
      background: var(--bg);
      padding: 16px;
      overflow-x: auto;
      margin: 16px 0;
      border: 1px solid var(--border);
    }

    .content pre code {
      background: none;
      padding: 0;
    }

    .content hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 32px 0;
    }

    .content strong {
      color: var(--fg);
      font-weight: 400;
    }

    .content a {
      text-decoration: underline;
      text-decoration-color: rgba(34, 211, 238, 0.4);
      text-underline-offset: 2px;
    }

    .content a:hover {
      text-decoration-color: var(--accent);
      opacity: 1;
    }
  </style>
</head>
<body>
  <div class="container">
    <a href="/" class="back">
      <span>←</span> All posts
    </a>
    
    <article class="article-window">
      <div class="window-header">
        <div class="window-buttons">
          <span class="window-button close"></span>
          <span class="window-button minimize"></span>
          <span class="window-button maximize"></span>
        </div>
        <span class="window-title">{post.data.title}.md</span>
      </div>
      <div class="window-content">
        <header>
          <h1>{post.data.title}</h1>
          {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
          <time class="date" datetime={post.data.date.toISOString()}>
            {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
        </header>
        
        <div class="content">
          <Content />
        </div>
      </div>
    </article>
  </div>
</body>
</html>
