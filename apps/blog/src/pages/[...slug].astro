---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{post.data.title} — Ryan Palermo</title>
  <meta name="description" content={post.data.excerpt}>
  <meta property="og:title" content={post.data.title}>
  <meta property="og:description" content={post.data.excerpt}>
  <meta property="og:type" content="article">
  <link rel="alternate" type="application/rss+xml" title="Ryan Palermo's Blog" href="/rss.xml">
  <link rel="icon" type="image/png" href="/favicon.png">
  <style is:global>
    :root {
      --bg: #0c0c0c;
      --fg: #f2f2f2;
      --fg-muted: #a3a3a3;
      --fg-dim: #808080;
      --border: #333333;
      --surface: #111;
      --link: #60a5fa;
      --link-hover: #93c5fd;
      color-scheme: dark;
    }

    [data-theme="light"] {
      --bg: #fafafa;
      --fg: #171717;
      --fg-muted: #525252;
      --fg-dim: #666666; /* Improved contrast from #737373 */
      --border: #e5e5e5;
      --surface: #ffffff;
      --link: #2563eb;
      --link-hover: #1d4ed8;
      color-scheme: light;
    }

    /* ===========================================
       LIGHT MODE OVERRIDES FOR INLINE HTML
       Override hardcoded dark mode colors in post content
       =========================================== */
    
    /* Dark backgrounds → light backgrounds */
    [data-theme="light"] .content div[style*="background: #0d0d0d"],
    [data-theme="light"] .content div[style*="background:#0d0d0d"] {
      background: #f5f5f5 !important;
    }

    [data-theme="light"] .content div[style*="background: #1a1a1a"],
    [data-theme="light"] .content div[style*="background:#1a1a1a"] {
      background: #f0f0f0 !important;
    }

    [data-theme="light"] .content div[style*="background: #111"],
    [data-theme="light"] .content div[style*="background:#111"] {
      background: #f5f5f5 !important;
    }

    [data-theme="light"] .content div[style*="background: #0a0a0a"],
    [data-theme="light"] .content div[style*="background:#0a0a0a"] {
      background: #f8f8f8 !important;
    }

    /* Dark borders → light borders */
    [data-theme="light"] .content div[style*="border: 1px solid #333"],
    [data-theme="light"] .content div[style*="border:1px solid #333"] {
      border-color: #d4d4d4 !important;
    }

    [data-theme="light"] .content div[style*="border: 1px solid #262626"],
    [data-theme="light"] .content div[style*="border:1px solid #262626"] {
      border-color: #d4d4d4 !important;
    }

    [data-theme="light"] .content div[style*="border: 1px solid #404040"] {
      border-color: #c4c4c4 !important;
    }

    /* Gradient backgrounds */
    [data-theme="light"] .content div[style*="linear-gradient(135deg, #0d0d0d"] {
      background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%) !important;
    }

    /* Text colors - light gray text on dark → dark text on light */
    [data-theme="light"] .content div[style*="color: #e5e5e5"] {
      color: #171717 !important;
    }

    [data-theme="light"] .content span[style*="color: #e5e5e5"] {
      color: #171717 !important;
    }

    [data-theme="light"] .content div[style*="color: #a3a3a3"] {
      color: #525252 !important;
    }

    [data-theme="light"] .content span[style*="color: #a3a3a3"] {
      color: #525252 !important;
    }

    [data-theme="light"] .content div[style*="color: #737373"] {
      color: #666666 !important;
    }

    [data-theme="light"] .content span[style*="color: #737373"] {
      color: #666666 !important;
    }

    [data-theme="light"] .content div[style*="color: #525252"] {
      color: #737373 !important;
    }

    [data-theme="light"] .content span[style*="color: #525252"] {
      color: #737373 !important;
    }

    [data-theme="light"] .content div[style*="color: #888"] {
      color: #666666 !important;
    }

    /* Error state backgrounds - keep semantic but adjust */
    [data-theme="light"] .content div[style*="background: #2a1717"] {
      background: #fef2f2 !important;
    }

    [data-theme="light"] .content div[style*="border: 1px solid #7f1d1d"],
    [data-theme="light"] .content div[style*="border: 1px solid #991b1b"] {
      border-color: #fca5a5 !important;
    }

    /* Success state backgrounds */
    [data-theme="light"] .content div[style*="background: #14291a"] {
      background: #f0fdf4 !important;
    }

    [data-theme="light"] .content div[style*="border: 1px solid #166534"] {
      border-color: #86efac !important;
    }

    /* Warning state backgrounds */
    [data-theme="light"] .content div[style*="background: #1c1917"] {
      background: #fefce8 !important;
    }

    [data-theme="light"] .content div[style*="border: 1px solid #a16207"] {
      border-color: #fcd34d !important;
    }

    /* Info/Blue state backgrounds */
    [data-theme="light"] .content div[style*="background: #1e3a5f"],
    [data-theme="light"] .content div[style*="background: #1e293b"] {
      background: #eff6ff !important;
    }

    [data-theme="light"] .content div[style*="border: 1px solid #1e40af"] {
      border-color: #93c5fd !important;
    }

    /* Purple state backgrounds */
    [data-theme="light"] .content div[style*="background: #1a1a2e"],
    [data-theme="light"] .content div[style*="background: #2e1a47"] {
      background: #faf5ff !important;
    }

    /* Orange/conflict state backgrounds */
    [data-theme="light"] .content div[style*="background: #2a1f17"] {
      background: #fff7ed !important;
    }

    /* Buttons and interactive elements */
    [data-theme="light"] .content button[style*="background: #262626"] {
      background: #e5e5e5 !important;
      color: #525252 !important;
    }

    [data-theme="light"] .content span[style*="background: #262626"] {
      background: #e5e5e5 !important;
    }

    /* Code/monospace backgrounds */
    [data-theme="light"] .content code[style*="background: #262626"],
    [data-theme="light"] .content code[style*="background: #1a1a1a"] {
      background: #f0f0f0 !important;
    }

    /* Input fields */
    [data-theme="light"] .content input[style*="background: #1a1a1a"] {
      background: #ffffff !important;
      border-color: #d4d4d4 !important;
      color: #171717 !important;
    }

    [data-theme="light"] .content select[style*="background: #1a1a1a"] {
      background: #ffffff !important;
      border-color: #d4d4d4 !important;
      color: #171717 !important;
    }

    /* Stack tags and pills */
    [data-theme="light"] .content span[style*="background: rgba(255, 255, 255, 0.05)"] {
      background: rgba(0, 0, 0, 0.05) !important;
    }

    /* Progress bars backgrounds */
    [data-theme="light"] .content div[style*="background: #262626"][style*="border-radius: 2px"] {
      background: #e5e5e5 !important;
    }

    /* Status badges with specific colors - keep semantic */
    [data-theme="light"] .content span[style*="background: #14291a"] {
      background: #dcfce7 !important;
    }

    [data-theme="light"] .content span[style*="background: #1e3a5f"] {
      background: #dbeafe !important;
    }

    [data-theme="light"] .content span[style*="background: #1c1917"] {
      background: #fef9c3 !important;
    }

    [data-theme="light"] .content span[style*="background: #2a1717"] {
      background: #fee2e2 !important;
    }

    /* Dim arrow/separator colors */
    [data-theme="light"] .content div[style*="color: #404040"] {
      color: #a3a3a3 !important;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "SF Mono", Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 14px;
      line-height: 1.6;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--link);
      color: var(--bg);
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 24px 64px;
      width: 90%;
    }

    @media (min-width: 1200px) {
      .container {
        max-width: 900px;
      }
    }

    @media (min-width: 1600px) {
      .container {
        max-width: 1000px;
      }
    }

    a {
      color: var(--link);
      text-decoration: none;
      transition: color 0.15s;
    }

    a:hover { color: var(--link-hover); }

    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 48px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--fg-dim);
    }

    .back:hover { color: var(--fg-muted); }

    .initials {
      font-size: 20px;
      font-weight: 600;
      color: var(--fg);
      text-decoration: none;
      letter-spacing: -1px;
      transition: opacity 0.15s;
      border: 1px solid var(--fg);
      padding: 4px 8px;
    }

    .initials:hover { opacity: 0.7; color: var(--fg); }

    .theme-toggle {
      background: none;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      cursor: pointer;
      color: var(--fg-muted);
      font-size: 14px;
      transition: all 0.15s;
    }

    .theme-toggle:hover {
      background: var(--surface);
      color: var(--fg);
    }

    header {
      margin-bottom: 48px;
    }

    h1 {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: -0.5px;
      line-height: 1.3;
      margin-bottom: 12px;
    }

    .subtitle {
      color: var(--fg-muted);
      font-size: 16px;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .date {
      font-size: 12px;
      color: var(--fg-dim);
    }

    .content {
      color: var(--fg-muted);
      line-height: 1.8;
      font-size: 15px;
    }

    .content h2 {
      color: var(--fg);
      font-size: 20px;
      font-weight: 400;
      margin: 48px 0 24px;
    }

    .content h3 {
      color: var(--fg);
      font-size: 16px;
      font-weight: 400;
      margin: 32px 0 16px;
    }

    .content p {
      margin-bottom: 20px;
    }

    .content ul, .content ol {
      margin-bottom: 20px;
      padding-left: 24px;
    }

    .content li {
      margin-bottom: 10px;
    }

    .content li::marker {
      color: var(--fg-dim);
    }

    .content blockquote {
      border-left: 2px solid var(--link);
      padding-left: 20px;
      margin: 32px 0;
      color: var(--fg-muted);
      font-style: italic;
    }

    .content code {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 13px;
    }

    .content pre {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 20px;
      overflow-x: auto;
      margin: 24px 0;
      border-radius: 6px;
    }

    .content pre code {
      background: none;
      border: none;
      padding: 0;
    }

    .content hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 48px 0;
    }

    .content strong {
      color: var(--fg);
      font-weight: 500;
    }

    .content a {
      text-decoration: underline;
      text-decoration-color: rgba(96, 165, 250, 0.4);
      text-underline-offset: 3px;
    }

    .content a:hover {
      text-decoration-color: var(--link);
    }

    /* ===========================================
       BLOG DIAGRAM UTILITIES (class-based)
       Used by inline HTML inside markdown posts.
       =========================================== */

    .content .blog-grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin: 32px 0;
    }

    .content .blog-grid-3col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 32px 0;
    }

    .content .blog-grid-2col-auto {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 16px;
      align-items: center;
      margin: 32px 0;
    }

    .content .blog-diagram-card {
      padding: 24px;
      border-radius: 8px;
      background: #1a1a1a;
      border: 1px solid #333;
      height: 100%;
      position: relative;
      overflow: hidden;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .content .blog-diagram-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }

    .content .blog-diagram-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 600;
      color: var(--fg-dim);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .content .blog-diagram-content {
      background: #0d0d0d;
      border-radius: 6px;
      padding: 16px;
      border: 1px solid #262626;
    }

    .content .blog-diagram-caption {
      margin-top: 12px;
      font-size: 13px;
      color: #888;
      font-style: italic;
    }

    /* Light mode overrides for blog diagrams */
    [data-theme="light"] .content .blog-diagram-card {
      background: #f5f5f5;
      border-color: #d4d4d4;
      box-shadow: none;
    }

    [data-theme="light"] .content .blog-diagram-card:hover {
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
    }

    [data-theme="light"] .content .blog-diagram-content {
      background: #ffffff;
      border: 1px solid #e5e5e5;
    }

    /* Responsive adjustments for blog diagrams */
    @media (max-width: 768px) {
      .content .blog-grid-2col,
      .content .blog-grid-2col-auto {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .content .blog-grid-3col {
        grid-template-columns: 1fr;
      }

      .content .blog-grid-2col-auto > div:nth-child(2) {
        /* The arrow in "The deletion test" */
        transform: rotate(90deg);
        text-align: center;
        margin: 8px 0;
      }
    }

    @media (max-width: 640px) {
      h1 { font-size: 24px; }
      .content { font-size: 14px; }
    }

    /* ===========================================
       RESPONSIVE INLINE HTML OVERRIDES
       These target inline styles in blog post content
       to make them mobile-friendly
       =========================================== */

    /* 2-column grids → stack on mobile/tablet */
    @media (max-width: 768px) {
      .content div[style*="grid-template-columns: 1fr 1fr"],
      .content div[style*="grid-template-columns:1fr 1fr"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 16px !important;
      }

      .content div[style*="repeat(2, 1fr)"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
      }
    }

    /* 3-column grids → stack on mobile/tablet */
    @media (max-width: 768px) {
      .content div[style*="repeat(3, 1fr)"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
      }

      /* 3-column deletion test grid with arrow */
      .content div[style*="grid-template-columns: 1fr auto 1fr"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 16px !important;
      }

      /* Hide arrows in stacked layout */
      .content div[style*="grid-template-columns: 1fr auto 1fr"] > div[style*="color: #525252"][style*="font-size: 24px"] {
        display: none !important;
      }
    }

    /* Horizontal flex containers → wrap or stack */
    @media (max-width: 768px) {
      /* Pipeline/flow diagrams with arrows */
      .content div[style*="display: flex"][style*="align-items: center"][style*="gap: 12px"] {
        flex-wrap: wrap !important;
        justify-content: center !important;
      }

      /* The explanation spiral - horizontal steps */
      .content div[style*="display: flex"][style*="align-items: stretch"] {
        flex-direction: column !important;
        gap: 8px !important;
      }

      /* Hide arrow separators in horizontal flows on mobile */
      .content div[style*="display: flex"][style*="align-items: center"] > div[style*="color: #525252"]:not([style*="background"]),
      .content div[style*="display: flex"][style*="align-items: center"] > div[style*="color: #404040"] {
        display: none !important;
      }

      /* Loading states horizontal flex */
      .content div[style*="display: flex"][style*="gap: 16px"][style*="overflow-x: auto"] {
        flex-wrap: wrap !important;
        justify-content: center !important;
        overflow-x: visible !important;
      }

      /* Elements with min-width that cause horizontal scroll */
      .content div[style*="min-width: 140px"] {
        min-width: 100% !important;
        flex: 1 1 100% !important;
      }

      .content div[style*="flex: 1"][style*="min-width"] {
        min-width: unset !important;
        flex: 1 1 100% !important;
      }
    }

    /* Workarounds list - vertical flex with icons */
    @media (max-width: 640px) {
      .content div[style*="display: flex"][style*="flex-direction: column"][style*="gap: 12px"] > div[style*="display: flex"][style*="align-items: center"][style*="gap: 16px"] {
        flex-direction: row !important;
        flex-wrap: wrap !important;
      }

      /* Icon + text pairs in workaround items */
      .content div[style*="font-size: 24px"] + div {
        flex: 1 !important;
        min-width: 200px !important;
      }
    }

    /* Stress tags flex wrap */
    @media (max-width: 640px) {
      .content div[style*="display: flex"][style*="flex-wrap: wrap"][style*="gap: 10px"] {
        gap: 8px !important;
      }

      .content div[style*="display: flex"][style*="flex-wrap: wrap"] > span {
        flex: 0 1 auto !important;
      }
    }

    /* Two-question boxes side by side */
    @media (max-width: 640px) {
      .content div[style*="display: grid"][style*="gap: 16px"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
      }
    }

    /* Fix padding and margins for mobile */
    @media (max-width: 640px) {
      .content div[style*="padding: 20px"] {
        padding: 16px !important;
      }

      .content div[style*="padding: 24px"] {
        padding: 16px !important;
      }

      .content div[style*="margin: 32px 0"] {
        margin: 24px 0 !important;
      }

      .content div[style*="gap: 24px"] {
        gap: 16px !important;
      }
    }

    /* Ensure all content boxes don't overflow */
    @media (max-width: 768px) {
      .content div[style*="border-radius"] {
        max-width: 100% !important;
        overflow-x: hidden !important;
      }

      .content div[style*="background:"] {
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
      }
    }

    /* Form inputs in examples - ensure they don't overflow */
    @media (max-width: 640px) {
      .content input[style*="width: 100%"] {
        max-width: 100% !important;
      }

      .content select[style*="width: 100%"] {
        max-width: 100% !important;
      }
    }

    /* Stats/metrics grids */
    @media (max-width: 640px) {
      .content div[style*="display: grid"][style*="repeat(3, 1fr)"] > div {
        text-align: left !important;
      }
    }

    /* Button groups in examples */
    @media (max-width: 480px) {
      .content div[style*="display: flex"][style*="gap: 8px"] {
        flex-wrap: wrap !important;
      }

      .content div[style*="display: flex"][style*="gap: 12px"]:not([style*="flex-direction: column"]) {
        flex-wrap: wrap !important;
      }
    }

    /* Large quote/callout boxes */
    @media (max-width: 640px) {
      .content div[style*="font-size: 18px"] {
        font-size: 16px !important;
      }

      .content div[style*="font-size: 20px"] {
        font-size: 17px !important;
      }

      .content div[style*="font-size: 28px"] {
        font-size: 22px !important;
      }

      .content div[style*="font-size: 48px"] {
        font-size: 32px !important;
      }
    }

    /* Tooltip example - ensure positioning doesn't break */
    @media (max-width: 640px) {
      .content span[style*="position: absolute"] {
        position: static !important;
        display: block !important;
        transform: none !important;
        margin-top: 8px !important;
      }
    }

    /* ===========================================
       ADDITIONAL RESPONSIVE FIXES
       For specific patterns in blog posts
       =========================================== */

    /* Payment status progression diagram (data-model.md) */
    @media (max-width: 768px) {
      .content div[style*="display: flex"][style*="align-items: center"][style*="gap: 4px"] {
        flex-direction: column !important;
        gap: 12px !important;
      }
      
      /* Hide the gradient separator lines between steps */
      .content div[style*="display: flex"][style*="gap: 4px"] > div[style*="height: 2px"][style*="background: linear-gradient"] {
        display: none !important;
      }
    }

    /* Internal/external comparison grids */
    @media (max-width: 768px) {
      .content div[style*="display: grid"][style*="gap: 24px"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 16px !important;
      }
    }

    /* Draft/published transition diagram */
    @media (max-width: 640px) {
      .content div[style*="display: flex"][style*="gap: 16px"][style*="padding: 20px"] {
        flex-direction: column !important;
        align-items: stretch !important;
      }
      
      /* Hide arrow between draft and published */
      .content div[style*="display: flex"][style*="gap: 16px"] > div[style*="display: flex"][style*="align-items: center"][style*="color: #525252"] {
        display: none !important;
      }
    }

    /* Benefits grid (2x2) in captive-users.md */
    @media (max-width: 640px) {
      .content div[style*="display: grid"][style*="grid-template-columns: repeat(2, 1fr)"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
      }
    }

    /* Status badges/pills display properly */
    @media (max-width: 640px) {
      .content div[style*="display: flex"][style*="flex-wrap: wrap"][style*="gap: 10px"] > span,
      .content div[style*="display: flex"][style*="flex-wrap: wrap"][style*="gap: 8px"] > span {
        flex: 0 0 auto !important;
        white-space: nowrap !important;
      }
    }

    /* Min-width items that cause overflow - catch more patterns */
    @media (max-width: 768px) {
      .content div[style*="min-width: 80px"] {
        min-width: unset !important;
        width: 100% !important;
      }
    }

    /* Grid auto columns that might overflow */
    @media (max-width: 640px) {
      .content div[style*="display: grid"][style*="grid-template-columns: auto 1fr"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 4px !important;
      }
    }

    /* Ensure nested flex items in cards don't overflow */
    @media (max-width: 640px) {
      .content div[style*="border-radius"] div[style*="display: flex"][style*="justify-content: space-between"] {
        flex-wrap: wrap !important;
        gap: 8px !important;
      }
    }

    /* Receipt card layout */
    @media (max-width: 480px) {
      .content div[style*="max-width: 400px"] {
        max-width: 100% !important;
      }
    }

    /* Cost/time labels in flexible layouts */
    @media (max-width: 640px) {
      .content div[style*="display: flex"][style*="justify-content: space-between"][style*="margin-bottom"] {
        flex-direction: column !important;
        gap: 4px !important;
        align-items: flex-start !important;
      }
    }

    /* Ensure border-left accents don't cause layout issues */
    @media (max-width: 640px) {
      .content div[style*="border-left: 3px solid"],
      .content div[style*="border-left: 4px solid"],
      .content div[style*="border-left: 2px solid"] {
        padding-left: 12px !important;
      }
    }

    /* Inline monospace IDs don't overflow */
    @media (max-width: 480px) {
      .content span[style*="font-family: monospace"] {
        word-break: break-all !important;
      }
    }

    /* Small screen text sizing improvements */
    @media (max-width: 480px) {
      .content div[style*="font-size: 16px"] {
        font-size: 15px !important;
      }
      
      .content div[style*="font-size: 14px"] {
        font-size: 13px !important;
      }
    }

    .footer {
      margin-top: 64px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }

    .copyright {
      text-align: center;
      font-size: 12px;
      color: var(--fg-dim);
    }
  </style>
  <script is:inline>
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  </script>
</head>
<body>
  <div class="container">
    <nav class="nav">
      <a href="/" class="initials" aria-label="Home">RP</a>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <span id="theme-icon">☀️</span>
      </button>
    </nav>
    
    <article>
      <header>
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
        {post.data.date && (
          <time class="date" datetime={new Date(post.data.date).toISOString()}>
            {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
        )}
      </header>
      
      <div class="content">
        <Content />
      </div>
    </article>

    <footer class="footer">
      <div class="copyright">©2026 Ryan Palermo</div>
    </footer>
  </div>

  <script is:inline>
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('theme-icon').textContent = next === 'dark' ? '☀️' : '🌙';
    }
    document.getElementById('theme-icon').textContent = 
      document.documentElement.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
  </script>
</body>
</html>
