---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{post.data.title} — Ryan Palermo</title>
  <meta name="description" content={post.data.excerpt}>
  <meta property="og:title" content={post.data.title}>
  <meta property="og:description" content={post.data.excerpt}>
  <meta property="og:type" content="article">
  <link rel="alternate" type="application/rss+xml" title="Ryan Palermo's Blog" href="/rss.xml">
  <style>
    :root {
      --bg: #0c0c0c;
      --fg: #f2f2f2;
      --fg-muted: #a3a3a3;
      --fg-dim: #808080;
      --border: #333333;
      --surface: #111;
      --link: #60a5fa;
      --link-hover: #93c5fd;
      color-scheme: dark;
    }

    [data-theme="light"] {
      --bg: #fafafa;
      --fg: #171717;
      --fg-muted: #525252;
      --fg-dim: #737373;
      --border: #e5e5e5;
      --surface: #ffffff;
      --link: #2563eb;
      --link-hover: #1d4ed8;
      color-scheme: light;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "SF Mono", Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 14px;
      line-height: 1.6;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--link);
      color: var(--bg);
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 24px 64px;
      width: 90%;
    }

    @media (min-width: 1200px) {
      .container {
        max-width: 900px;
      }
    }

    @media (min-width: 1600px) {
      .container {
        max-width: 1000px;
      }
    }

    a {
      color: var(--link);
      text-decoration: none;
      transition: color 0.15s;
    }

    a:hover { color: var(--link-hover); }

    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 48px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--fg-dim);
    }

    .back:hover { color: var(--fg-muted); }

    .theme-toggle {
      background: none;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      cursor: pointer;
      color: var(--fg-muted);
      font-size: 14px;
      transition: all 0.15s;
    }

    .theme-toggle:hover {
      background: var(--surface);
      color: var(--fg);
    }

    header {
      margin-bottom: 48px;
    }

    h1 {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: -0.5px;
      line-height: 1.3;
      margin-bottom: 12px;
    }

    .subtitle {
      color: var(--fg-muted);
      font-size: 16px;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .date {
      font-size: 12px;
      color: var(--fg-dim);
    }

    .content {
      color: var(--fg-muted);
      line-height: 1.8;
      font-size: 15px;
    }

    .content h2 {
      color: var(--fg);
      font-size: 20px;
      font-weight: 400;
      margin: 48px 0 24px;
    }

    .content h3 {
      color: var(--fg);
      font-size: 16px;
      font-weight: 400;
      margin: 32px 0 16px;
    }

    .content p {
      margin-bottom: 20px;
    }

    .content ul, .content ol {
      margin-bottom: 20px;
      padding-left: 24px;
    }

    .content li {
      margin-bottom: 10px;
    }

    .content li::marker {
      color: var(--fg-dim);
    }

    .content blockquote {
      border-left: 2px solid var(--link);
      padding-left: 20px;
      margin: 32px 0;
      color: var(--fg-muted);
      font-style: italic;
    }

    .content code {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 13px;
    }

    .content pre {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 20px;
      overflow-x: auto;
      margin: 24px 0;
      border-radius: 6px;
    }

    .content pre code {
      background: none;
      border: none;
      padding: 0;
    }

    .content hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 48px 0;
    }

    .content strong {
      color: var(--fg);
      font-weight: 500;
    }

    .content a {
      text-decoration: underline;
      text-decoration-color: rgba(96, 165, 250, 0.4);
      text-underline-offset: 3px;
    }

    .content a:hover {
      text-decoration-color: var(--link);
    }

    @media (max-width: 640px) {
      h1 { font-size: 24px; }
      .content { font-size: 14px; }
    }

    /* ===========================================
       RESPONSIVE INLINE HTML OVERRIDES
       These target inline styles in blog post content
       to make them mobile-friendly
       =========================================== */

    /* 2-column grids → stack on mobile/tablet */
    @media (max-width: 768px) {
      .content div[style*="grid-template-columns: 1fr 1fr"],
      .content div[style*="grid-template-columns:1fr 1fr"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 16px !important;
      }

      .content div[style*="repeat(2, 1fr)"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
      }
    }

    /* 3-column grids → stack on mobile/tablet */
    @media (max-width: 768px) {
      .content div[style*="repeat(3, 1fr)"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
      }

      /* 3-column deletion test grid with arrow */
      .content div[style*="grid-template-columns: 1fr auto 1fr"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 16px !important;
      }

      /* Hide arrows in stacked layout */
      .content div[style*="grid-template-columns: 1fr auto 1fr"] > div[style*="color: #525252"][style*="font-size: 24px"] {
        display: none !important;
      }
    }

    /* Horizontal flex containers → wrap or stack */
    @media (max-width: 768px) {
      /* Pipeline/flow diagrams with arrows */
      .content div[style*="display: flex"][style*="align-items: center"][style*="gap: 12px"] {
        flex-wrap: wrap !important;
        justify-content: center !important;
      }

      /* The explanation spiral - horizontal steps */
      .content div[style*="display: flex"][style*="align-items: stretch"] {
        flex-direction: column !important;
        gap: 8px !important;
      }

      /* Hide arrow separators in horizontal flows on mobile */
      .content div[style*="display: flex"][style*="align-items: center"] > div[style*="color: #525252"]:not([style*="background"]),
      .content div[style*="display: flex"][style*="align-items: center"] > div[style*="color: #404040"] {
        display: none !important;
      }

      /* Loading states horizontal flex */
      .content div[style*="display: flex"][style*="gap: 16px"][style*="overflow-x: auto"] {
        flex-wrap: wrap !important;
        justify-content: center !important;
        overflow-x: visible !important;
      }

      /* Elements with min-width that cause horizontal scroll */
      .content div[style*="min-width: 140px"] {
        min-width: 100% !important;
        flex: 1 1 100% !important;
      }

      .content div[style*="flex: 1"][style*="min-width"] {
        min-width: unset !important;
        flex: 1 1 100% !important;
      }
    }

    /* Workarounds list - vertical flex with icons */
    @media (max-width: 640px) {
      .content div[style*="display: flex"][style*="flex-direction: column"][style*="gap: 12px"] > div[style*="display: flex"][style*="align-items: center"][style*="gap: 16px"] {
        flex-direction: row !important;
        flex-wrap: wrap !important;
      }

      /* Icon + text pairs in workaround items */
      .content div[style*="font-size: 24px"] + div {
        flex: 1 !important;
        min-width: 200px !important;
      }
    }

    /* Stress tags flex wrap */
    @media (max-width: 640px) {
      .content div[style*="display: flex"][style*="flex-wrap: wrap"][style*="gap: 10px"] {
        gap: 8px !important;
      }

      .content div[style*="display: flex"][style*="flex-wrap: wrap"] > span {
        flex: 0 1 auto !important;
      }
    }

    /* Two-question boxes side by side */
    @media (max-width: 640px) {
      .content div[style*="display: grid"][style*="gap: 16px"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
      }
    }

    /* Fix padding and margins for mobile */
    @media (max-width: 640px) {
      .content div[style*="padding: 20px"] {
        padding: 16px !important;
      }

      .content div[style*="padding: 24px"] {
        padding: 16px !important;
      }

      .content div[style*="margin: 32px 0"] {
        margin: 24px 0 !important;
      }

      .content div[style*="gap: 24px"] {
        gap: 16px !important;
      }
    }

    /* Ensure all content boxes don't overflow */
    @media (max-width: 768px) {
      .content div[style*="border-radius"] {
        max-width: 100% !important;
        overflow-x: hidden !important;
      }

      .content div[style*="background:"] {
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
      }
    }

    /* Form inputs in examples - ensure they don't overflow */
    @media (max-width: 640px) {
      .content input[style*="width: 100%"] {
        max-width: 100% !important;
      }

      .content select[style*="width: 100%"] {
        max-width: 100% !important;
      }
    }

    /* Stats/metrics grids */
    @media (max-width: 640px) {
      .content div[style*="display: grid"][style*="repeat(3, 1fr)"] > div {
        text-align: left !important;
      }
    }

    /* Button groups in examples */
    @media (max-width: 480px) {
      .content div[style*="display: flex"][style*="gap: 8px"] {
        flex-wrap: wrap !important;
      }

      .content div[style*="display: flex"][style*="gap: 12px"]:not([style*="flex-direction: column"]) {
        flex-wrap: wrap !important;
      }
    }

    /* Large quote/callout boxes */
    @media (max-width: 640px) {
      .content div[style*="font-size: 18px"] {
        font-size: 16px !important;
      }

      .content div[style*="font-size: 20px"] {
        font-size: 17px !important;
      }

      .content div[style*="font-size: 28px"] {
        font-size: 22px !important;
      }

      .content div[style*="font-size: 48px"] {
        font-size: 32px !important;
      }
    }

    /* Tooltip example - ensure positioning doesn't break */
    @media (max-width: 640px) {
      .content span[style*="position: absolute"] {
        position: static !important;
        display: block !important;
        transform: none !important;
        margin-top: 8px !important;
      }
    }
  </style>
  <script is:inline>
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  </script>
</head>
<body>
  <div class="container">
    <nav class="nav">
      <a href={import.meta.env.BASE_URL} class="back">
        <span>←</span> All posts
      </a>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <span id="theme-icon">☀️</span>
      </button>
    </nav>
    
    <article>
      <header>
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
        <time class="date" datetime={post.data.date.toISOString()}>
          {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
      </header>
      
      <div class="content">
        <Content />
      </div>
    </article>
  </div>

  <script is:inline>
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('theme-icon').textContent = next === 'dark' ? '☀️' : '🌙';
    }
    document.getElementById('theme-icon').textContent = 
      document.documentElement.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
  </script>
</body>
</html>
