---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const draftPosts = posts.filter((post) => post.data.draft);
const sortedPosts = [...draftPosts].sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const drafts = sortedPosts.map((post) => ({
  ...post,
  slug: post.id.replace(/\.md$/, ''),
}));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Drafts — Ryan Palermo</title>
  <meta name="description" content="Unlisted draft posts for review.">
  <meta name="robots" content="noindex,nofollow">
  <link rel="icon" type="image/png" href="/favicon.png">
  <style>
    :root {
      --bg: #0c0c0c;
      --fg: #f2f2f2;
      --fg-muted: #a3a3a3;
      --fg-dim: #808080;
      --border: #333333;
      --surface: #111;
      --link: #60a5fa;
      --link-hover: #93c5fd;
      color-scheme: dark;
    }

    [data-theme="light"] {
      --bg: #fafafa;
      --fg: #171717;
      --fg-muted: #525252;
      --fg-dim: #666666;
      --border: #e5e5e5;
      --surface: #ffffff;
      --link: #2563eb;
      --link-hover: #1d4ed8;
      color-scheme: light;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "SF Mono", Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 14px;
      line-height: 1.6;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--link);
      color: var(--bg);
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 24px 64px;
      width: 90%;
    }

    @media (min-width: 1200px) {
      .container {
        max-width: 900px;
      }
    }

    @media (min-width: 1600px) {
      .container {
        max-width: 1000px;
      }
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.15s;
    }

    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 48px;
      padding: 24px 0;
      border-bottom: 1px solid var(--border);
      position: relative;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .nav-link {
      font-size: 14px;
      color: var(--fg-muted);
      text-decoration: none;
      transition: color 0.15s;
    }

    .nav-link:hover {
      color: var(--fg);
    }

    .initials {
      font-size: 20px;
      font-weight: 600;
      color: var(--fg);
      text-decoration: none;
      letter-spacing: -1px;
      transition: opacity 0.15s;
      border: 1px solid var(--fg);
      padding: 4px 8px;
    }

    .initials:hover { opacity: 0.7; color: var(--fg); }

    .theme-toggle {
      background: none;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      cursor: pointer;
      color: var(--fg-muted);
      font-size: 14px;
      transition: all 0.15s;
    }

    .theme-toggle:hover {
      background: var(--surface);
      color: var(--fg);
    }

    .header {
      margin-bottom: 32px;
    }

    .header h1 {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: -0.5px;
      margin-bottom: 8px;
    }

    .header p {
      color: var(--fg-muted);
      font-size: 14px;
    }

    .section-title {
      font-size: 11px;
      color: var(--fg-dim);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 16px;
    }

    .posts {
      display: flex;
      flex-direction: column;
    }

    .post {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
      padding: 20px 0;
      border-bottom: 1px solid var(--border);
      transition: all 0.15s;
    }

    .post:last-child { border-bottom: none; }

    .post:hover .post-title {
      color: var(--fg);
    }

    .post-title {
      font-size: 15px;
      font-weight: 400;
      margin-bottom: 4px;
      color: var(--fg-muted);
      transition: color 0.15s;
    }

    .post-subtitle {
      font-size: 13px;
      color: var(--fg-dim);
      line-height: 1.5;
    }

    .post-meta {
      font-size: 12px;
      color: var(--fg-dim);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .empty {
      color: var(--fg-dim);
      font-size: 14px;
      padding: 24px 0;
      border-bottom: 1px solid var(--border);
    }

    @media (max-width: 640px) {
      .post {
        flex-direction: column;
        gap: 8px;
      }
      .post-meta {
        order: -1;
      }
    }

    .footer {
      margin-top: 64px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }

    .copyright {
      text-align: center;
      font-size: 12px;
      color: var(--fg-dim);
    }
  </style>
  <script is:inline>
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  </script>
</head>
<body>
  <div class="container">
    <nav class="nav">
      <a href="/" class="initials" aria-label="Home">RP</a>
      <div class="nav-links">
        <a href="/#projects" class="nav-link">Projects</a>
        <a href="/blog/" class="nav-link">Thoughts</a>
      </div>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <span id="theme-icon">☀️</span>
      </button>
    </nav>

    <header class="header">
      <h1>Drafts</h1>
      <p>Unlisted posts for review. Not indexed or linked publicly.</p>
    </header>

    <section>
      <div class="section-title">Draft posts</div>
      <div class="posts">
        {drafts.length === 0 ? (
          <p class="empty">No drafts right now.</p>
        ) : (
          drafts.map((post) => (
            <a href={`/drafts/${post.slug}/`} class="post">
              <div>
                <div class="post-title">{post.data.title}</div>
                {post.data.subtitle && <div class="post-subtitle">{post.data.subtitle}</div>}
              </div>
              {post.data.date && (
                <time class="post-meta" datetime={new Date(post.data.date).toISOString()}>
                  {new Date(post.data.date).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
              )}
            </a>
          ))
        )}
      </div>
    </section>

    <footer class="footer">
      <div class="copyright">©2026 Ryan Palermo</div>
    </footer>
  </div>

  <script is:inline>
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('theme-icon').textContent = next === 'dark' ? '☀️' : '🌙';
    }
    document.getElementById('theme-icon').textContent =
      document.documentElement.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
  </script>
</body>
</html>
