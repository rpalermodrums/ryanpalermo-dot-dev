---
import { blogPosts } from '@ryanpalermo/shared';

const sortedPosts = [...blogPosts].sort((a, b) => 
  new Date(b.date).getTime() - new Date(a.date).getTime()
);
const featuredPost = sortedPosts.find(p => p.featured);
const regularPosts = sortedPosts.filter(p => !p.featured);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thoughts — Ryan Palermo</title>
  <meta name="description" content="Essays on product engineering, operational honesty, and building software that respects users.">
  <link rel="alternate" type="application/rss+xml" title="Thoughts - Palermo" href="/rss.xml">
  <style>
    :root {
      --bg: #0c0c0c;
      --fg: #f2f2f2;
      --fg-muted: #a3a3a3;
      --fg-dim: #808080;
      --border: #333333;
      --surface: #111;
      --link: #60a5fa;
      --link-hover: #93c5fd;
      color-scheme: dark;
    }

    [data-theme="light"] {
      --bg: #fafafa;
      --fg: #171717;
      --fg-muted: #525252;
      --fg-dim: #666666; /* Improved contrast from #737373 */
      --border: #e5e5e5;
      --surface: #ffffff;
      --link: #2563eb;
      --link-hover: #1d4ed8;
      color-scheme: light;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "SF Mono", Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 14px;
      line-height: 1.6;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--link);
      color: var(--bg);
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 24px 64px;
      width: 90%;
    }

    @media (min-width: 1200px) {
      .container {
        max-width: 900px;
      }
    }

    @media (min-width: 1600px) {
      .container {
        max-width: 1000px;
      }
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.15s;
    }

    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 48px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--fg-dim);
    }

    .back:hover { color: var(--fg-muted); }

    .theme-toggle {
      background: none;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      cursor: pointer;
      color: var(--fg-muted);
      font-size: 14px;
      transition: all 0.15s;
    }

    .theme-toggle:hover {
      background: var(--surface);
      color: var(--fg);
    }

    .header {
      margin-bottom: 48px;
    }

    .header h1 {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: -0.5px;
      margin-bottom: 8px;
    }

    .header p {
      color: var(--fg-muted);
      font-size: 14px;
    }

    .featured {
      display: block;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 24px;
      margin-bottom: 48px;
      transition: border-color 0.15s;
    }

    .featured:hover {
      border-color: var(--fg-dim);
    }

    .featured-label {
      font-size: 11px;
      color: var(--fg-dim);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
    }

    .featured .post-title {
      font-size: 18px;
      margin-bottom: 8px;
      color: var(--fg);
    }

    .featured .post-subtitle {
      font-size: 14px;
      color: var(--fg-muted);
      margin-bottom: 16px;
      line-height: 1.5;
    }

    .featured .post-meta {
      font-size: 12px;
      color: var(--fg-dim);
    }

    .section-title {
      font-size: 11px;
      color: var(--fg-dim);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 24px;
    }

    .posts {
      display: flex;
      flex-direction: column;
    }

    .post {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 24px;
      padding: 20px 0;
      border-bottom: 1px solid var(--border);
      transition: all 0.15s;
    }

    .post:last-child { border-bottom: none; }

    .post:hover .post-title {
      color: var(--fg);
    }

    .post-title {
      font-size: 15px;
      font-weight: 400;
      margin-bottom: 4px;
      color: var(--fg-muted);
      transition: color 0.15s;
    }

    .post-subtitle {
      font-size: 13px;
      color: var(--fg-dim);
      line-height: 1.5;
    }

    .post-meta {
      font-size: 12px;
      color: var(--fg-dim);
      white-space: nowrap;
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      .post {
        flex-direction: column;
        gap: 8px;
      }
      .post-meta {
        order: -1;
      }
    }
  </style>
  <script is:inline>
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  </script>
</head>
<body>
  <div class="container">
    <nav class="nav">
      <a href="/" class="back">
        <span>←</span> Home
      </a>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <span id="theme-icon">☀️</span>
      </button>
    </nav>
    
    <header class="header">
      <h1>Thoughts</h1>
      <p>...on building things.</p>
    </header>

    {featuredPost && (
      <a href={`${import.meta.env.BASE_URL}/${featuredPost.slug}/`} class="featured">
        <div class="featured-label">Featured</div>
        <h2 class="post-title">{featuredPost.title}</h2>
        <p class="post-subtitle">{featuredPost.subtitle}</p>
        <div class="post-meta">
          {new Date(featuredPost.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </div>
      </a>
    )}

    <div class="section-title">All Posts</div>
    <section class="posts">
      {regularPosts.map(post => (
        <a href={`${import.meta.env.BASE_URL}/${post.slug}/`} class="post">
          <div>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-subtitle">{post.subtitle}</p>
          </div>
          <div class="post-meta">
            {new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
          </div>
        </a>
      ))}
    </section>
  </div>

  <script is:inline>
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('theme-icon').textContent = next === 'dark' ? '☀️' : '🌙';
    }
    document.getElementById('theme-icon').textContent = 
      document.documentElement.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
  </script>
</body>
</html>
